from collections import deque

class CropDiseaseSystem:

    def __init__(self):
        self.graph = {}

    def add_edge(self, u, v):
        self.graph.setdefault(u, [])
        self.graph.setdefault(v, [])

        if v not in self.graph[u]:
            self.graph[u].append(v)
            self.graph[v].append(u)

    def bfs(self, start):
        visited = {start}
        q = deque([start])
        result = []

        while q:
            node = q.popleft()
            result.append(node)

            for v in self.graph[node]:
                if v not in visited:
                    visited.add(v)
                    q.append(v)

        return result

    def dfs(self, node, visited, result):
        visited.add(node)
        result.append(node)

        for v in self.graph[node]:
            if v not in visited:
                self.dfs(v, visited, result)

    def connected_components(self):
        visited = set()
        zones = []

        for node in self.graph:
            if node not in visited:
                component = []
                q = deque([node])
                visited.add(node)

                while q:
                    current = q.popleft()
                    component.append(current)

                    for v in self.graph[current]:
                        if v not in visited:
                            visited.add(v)
                            q.append(v)

                zones.append(component)

        return zones

    def analyze(self):
        disc, low, parent = {}, {}, {}
        ap = set()
        bcc = []
        stack = []
        timer = [0]

        def visit(u):
            disc[u] = low[u] = timer[0]
            timer[0] += 1
            children = 0

            for v in self.graph[u]:
                if v not in disc:
                    children += 1
                    parent[v] = u
                    stack.append((u, v))

                    visit(v)
                    low[u] = min(low[u], low[v])

                    if parent[u] is None and children > 1:
                        ap.add(u)

                    if parent[u] is not None and low[v] >= disc[u]:
                        ap.add(u)

                    if low[v] >= disc[u]:
                        comp = set()

                        while stack:
                            edge = stack.pop()
                            comp.update(edge)

                            if edge == (u, v):
                                break

                        bcc.append(sorted(comp))

                elif v != parent[u] and disc[v] < disc[u]:
                    low[u] = min(low[u], disc[v])
                    stack.append((u, v))

        for node in self.graph:
            if node not in disc:
                parent[node] = None
                visit(node)

                if stack:
                    comp = set()
                    while stack:
                        comp.update(stack.pop())
                    bcc.append(sorted(comp))

        return sorted(ap), bcc

    def critical_ranking(self):
        original = len(self.connected_components())
        ranking = []

        for farm in self.graph:
            visited = {farm}
            count = 0

            for node in self.graph:
                if node not in visited:
                    count += 1
                    q = deque([node])
                    visited.add(node)

                    while q:
                        current = q.popleft()
                        for v in self.graph[current]:
                            if v not in visited:
                                visited.add(v)
                                q.append(v)

            ranking.append((farm, count - original + 1))

        return sorted(ranking, key=lambda x: x[1], reverse=True)


